{
  "name": "pseudolocale",
  "version": "3.1.0",
  "description": "Simple pseudolocale (psuedolocalization) for strings",
  "keywords": [
    "localization",
    "pseudolocale"
  ],
  "author": "Martin Cerny <cerny.mrtn@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinCerny-awin/pseudolocale"
  },
  "bin": {
    "pseudolocale": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint:types": "tsc",
    "prettier:check": "prettier --check '**/*.{ts,tsx}'",
    "lint": "eslint src && prettier -c {src,.}/**/*.ts --write && npm run lint:types"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "files": [
    "README.md",
    "dist/"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsdown": "0.22.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}
