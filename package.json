{
  "name": "pseudolocale",
  "version": "2.3.0",
  "description": "Simple pseudolocale (psuedolocalization) for strings",
  "keywords": [
    "localization",
    "pseudolocale"
  ],
  "author": "Martin Cerny <cerny.mrtn@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinCerny-awin/pseudolocale"
  },
  "bin": "./dist/cli.mjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint:types": "tsc",
    "prettier:check": "prettier --check '**/*.{ts,tsx}'",
    "lint": "eslint src && prettier -c {src,.}/**/*.ts --write && npm run lint:types"
  },
  "dependencies": {
    "commander": "^10.0.0"
  },
  "files": [
    "README.md",
    "dist/"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  }
}
